{
  "name": "ancestry",
  "displayName": "Ancestry — Code Ancestry Explorer",
  "description": "Reconstruct the semantic evolution of a code block across Git history, branches, and files.",
  "version": "0.1.0",
  "publisher": "ancestry-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "SCM Providers",
    "Programming Languages"
  ],
  "keywords": [
    "git",
    "ancestry",
    "code history",
    "similarity",
    "ast",
    "visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ancestry.analyzeSelection",
        "title": "Analyze Code Ancestry",
        "category": "Ancestry"
      },
      {
        "command": "ancestry.analyzeCurrentFile",
        "title": "Analyze a Block in File",
        "category": "Ancestry"
      },
      {
        "command": "ancestry.replayLastAnalysis",
        "title": "Replay Last Ancestry Analysis",
        "category": "Ancestry"
      },
      {
        "command": "ancestry.exportGraph",
        "title": "Export Ancestry Graph as JSON",
        "category": "Ancestry"
      },
      {
        "command": "ancestry.showSettings",
        "title": "Open Settings",
        "category": "Ancestry"
      },
      {
        "command": "ancestry.clearCache",
        "title": "Clear Ancestry Index Cache",
        "category": "Ancestry"
      },
      {
        "command": "ancestry.showCacheStats",
        "title": "Show Ancestry Cache Statistics",
        "category": "Ancestry"
      },
      {
        "command": "ancestry.cancelAnalysis",
        "title": "Cancel Running Analysis",
        "category": "Ancestry"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ancestry.analyzeSelection",
          "when": "editorHasSelection",
          "group": "ancestry@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ancestry.analyzeSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Ancestry",
      "properties": {
        "ancestry.git.maxHistoryDepth": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "maximum": 100000,
          "description": "Maximum number of commits to inspect per analysis. Guards against unbounded scans in very large repositories."
        },
        "ancestry.git.maxFileSizeBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 1024,
          "description": "Files larger than this (in bytes) are skipped during analysis."
        },
        "ancestry.git.maxRepositorySizeBytes": {
          "type": "number",
          "default": 5368709120,
          "minimum": 1048576,
          "description": "Repository size safeguard. Analysis is refused with a clear message when the working tree exceeds this size."
        },
        "ancestry.similarity.strongThreshold": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "Similarity at or above this value is classified as a strong candidate."
        },
        "ancestry.similarity.possibleThreshold": {
          "type": "number",
          "default": 0.75,
          "minimum": 0,
          "maximum": 1,
          "description": "Similarity at or above this value (but below the strong threshold) is classified as a possible candidate."
        },
        "ancestry.similarity.candidateWindow": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "description": "Number of shingle tokens in the sliding window used for MinHash/Jaccard estimation."
        },
        "ancestry.similarity.shingleSize": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "description": "Number of normalized tokens per shingle."
        },
        "ancestry.analysis.followRenames": {
          "type": "boolean",
          "default": true,
          "description": "Follow git-detected renames when walking history."
        },
        "ancestry.analysis.includeAllBranches": {
          "type": "boolean",
          "default": true,
          "description": "Include commits from all local branches, not only the current one."
        },
        "ancestry.analysis.maxBlocksPerFile": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Maximum number of code blocks extracted from a single file."
        },
        "ancestry.analysis.maxBlocksTotal": {
          "type": "number",
          "default": 200000,
          "minimum": 1,
          "description": "Hard cap on code blocks held in memory during a single analysis."
        },
        "ancestry.analysis.includeTests": {
          "type": "boolean",
          "default": true,
          "description": "Include test files when searching history for matches."
        },
        "ancestry.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Persist parsed blocks, normalizations, and hashes to a local index for faster repeat analyses."
        },
        "ancestry.cache.maxAgeDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Entries older than this are evicted from the local index."
        },
        "ancestry.cache.backend": {
          "type": "string",
          "enum": [
            "auto",
            "sqlite",
            "file"
          ],
          "default": "auto",
          "description": "Index backend. 'auto' uses node:sqlite when the runtime provides it and falls back to a checksummed JSON store otherwise."
        },
        "ancestry.privacy.logSourceCode": {
          "type": "boolean",
          "default": false,
          "description": "Never enable this. When true, source text is written to the Ancestry output channel. Source code is not logged by default."
        },
        "ancestry.experimental.workers": {
          "type": "boolean",
          "default": false,
          "description": "Use worker threads for parsing and similarity computation."
        },
        "ancestry.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "All processing is local. There is no telemetry backend in this extension; this setting exists so the privacy posture is explicit and documented."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node scripts/build.mjs && npm run webview:build",
    "build:dev": "node scripts/build.mjs --watch",
    "webview:build": "vite build",
    "webview:dev": "vite build --watch",
    "webview:preview": "node scripts/preview-webview.mjs --serve",
    "lint": "eslint src tests scripts --ext .ts,.mjs",
    "lint:fix": "eslint src tests scripts --ext .ts,.mjs --fix",
    "format": "prettier --write \"**/*.{ts,mjs,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,md,json,yml}\"",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run tests/performance",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "package": "node scripts/build.mjs && vsce package --no-dependencies --out ancestry.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@typescript/vfs": "^1.4.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
