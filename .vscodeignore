# .vscodeignore — what goes into the published .vsix.
#
# The extension ships two runtime artifacts and almost nothing else:
#
#   dist/extension.js   esbuild bundle of src/extension.ts (CommonJS, `vscode`
#                       marked external so VS Code provides the API module).
#   media/webview.js    Vite bundle of src/webview/client/main.tsx
#                       (self-contained IIFE; Three.js, d3 and React are inlined)
#                       plus media/webview.css.
#
# WHAT MUST BE SHIPPED
# --------------------
# `media/**` is not optional. The webview panel is created with
#
#   webview.options = { enableScripts: true, localResourceRoots: [Uri.joinPath(extUri, 'media')] }
#
# and the document is a hand-written HTML string from `src/webview/html.ts` that
# references the bundle through `asWebviewUri`. There is no `media/index.html`:
# the markup is generated at runtime so the CSP nonce can be per-load. The VS Code
# webview sandbox will refuse to load any script whose URI is outside
# `localResourceRoots`, so dropping `media/` produces a VSIX that installs
# cleanly and then renders a blank panel with a CSP error in the webview
# console. There is no bundling fallback for this and no packaging-time check
# in vsce, so the lines below are load-bearing.
#
# PATHS ARE A BLANKET DENY LIST, NOT AN ALLOW LIST
# ------------------------------------------------
# Everything below is explicitly excluded so that a stray file (a scratch
# script, a coverage report, a local settings file, a nested `node_modules`)
# cannot silently bloat the artifact. The `!` negations at the bottom re-admit
# the handful of files that are genuinely required. In `.vscodeignore`,
# later rules win, so the negations must stay last.

# --- sources, tests, tooling source -----------------------------------------
src/**
tests/**
scripts/**
docs/**

# --- repository metadata that has no business in a shipped extension --------
.github/**
.vscode/**
node_modules/**
out/
coverage/
.ancestry-demo/**

# --- build and test configuration -------------------------------------------
tsconfig*.json
vitest.config.ts
vite.config.ts
.eslintrc.cjs
.eslintcache
.prettierrc.json
.prettierignore
.editorconfig
# Working notes, not documentation. TODO.md tracks in-flight state and has no
# business in a published artifact.
TODO.md
# Generated by scripts/preview-webview.mjs (a local dev aid, never shipped).
preview.html

# --- source maps and other build residue ------------------------------------
**/*.map
*.ts
**/*.ts
**/*.test.ts
**/*.spec.ts
**/__tests__/**
**/__mocks__/**

# --- repository root noise --------------------------------------------------
.gitignore
.npmrc
.vscodeignore
CHANGELOG*.md.*
Ancestry_Complete_Implementation_Plan.md
*.vsix
*.log
.DS_Store
Thumbs.db

# --- the one custom exclude worth documenting -------------------------------
# Local settings are where a contributor's own `ancestry.*` overrides live.
# Shipping them would silently override a user's settings on install.
settings.json

# ================================= KEEP =====================================
# Re-admit exactly the files the installed extension reads at runtime. These
# come last because later patterns take precedence.

!dist/extension.js
!media/**

# Metadata the Marketplace renders on the extension page.
!package.json
!README.md
!LICENSE
!CHANGELOG.md
