# Published extension versions are all built from tags `v<semver>`; the
# repository is the source of truth and nothing is ever fetched from it at
# install time.
engine-strict=true

# Do not print the funding banner on every install. Open-source funding is
# still welcome, just not at the cost of 200 lines of install output.
fund=false

# Ranges are recorded deliberately: `^1.2.3` plus a committed lockfile is the
# combination that keeps `npm ci` reproducible while still allowing patches.
# Set to `true` only if the team wants exact pins in package.json.
save-exact=false
